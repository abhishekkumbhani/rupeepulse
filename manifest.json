{
  "manifest_version": 3,
  "name": "RupeePulse - Live USD/INR & EUR/INR Rates",
  "short_name": "RupeePulse",
  "version": "1.0.0",
  "description": "Live USD/INR & EUR/INR mid-market rates with real-time price alerts, sparkline charts, currency converter, and instant Chrome badge. Free. No signup.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RupeePulse - Live USD/INR & EUR/INR",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "https://www.xe.com/*"
  ]
}
